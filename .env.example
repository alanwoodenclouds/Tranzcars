# WoQuick CRM API origin (NOT the desk UI host).
# Example: https://api.woquick.in  (with API_TENANT_HOST for X-Forwarded-Host)
# Or a tenant-resolving API base if your deploy uses one.
API_BASE_URL=https://api.woquick.in

# Tenant host used for X-Forwarded-Host when calling the CRM API
API_TENANT_HOST=tranz-cars.crm.woquick.com

# Use mocks when live API is unavailable (true | false)
# Set to false to hit /api/v1/portal/* on API_BASE_URL
USE_MOCK_API=true

# Public keys (safe for client)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Canonical public origin used for sitemap, robots, OG, and JSON-LD
# Production example: https://www.tranzcars.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919895041111
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://www.google.com/search?kgmid=/g/11f384v66m&q=TRANZ+CARS+Kerala+Rent+A+Car+Company
